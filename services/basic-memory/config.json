{
  "projects": {
    "toolsense-kb": {
      "path": "/app/data/KB",
      "mode": "local"
    },
    "toolsense-research": {
      "path": "/app/data/KB/20_research",
      "mode": "local"
    }
  },
  "default_project": "toolsense-kb",
  "database_backend": "sqlite",
  "index_changes": true,
  "ensure_frontmatter_on_sync": true,
  "kebab_filenames": true,
  "semantic_search_enabled": true,
  "semantic_embedding_provider": "fastembed",
  "semantic_embedding_model": "bge-small-en-v1.5",
  "semantic_min_similarity": 0.55,
  "reranker_enabled": true,
  "reranker_provider": "fastembed",
  "reranker_model": "jinaai/jina-reranker-v1-tiny-en"
}

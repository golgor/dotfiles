#!/usr/bin/env bash
# Configure fnox secret loading for this machine.
#
# This task is intentionally manual, not automatic bootstrap: it may require
# Bitwarden login/unlock prompts and creates machine-local secret material.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: mise run setup-fnox [-- --no-sync]

Prepare fnox for this machine using the shared ~/fnox.toml manifest.

What this does:
  - verifies age, rbw, and fnox are installed
  - creates ~/.config/fnox/age.txt if missing
  - adds a machine-local sync-age provider to ~/.config/fnox/config.toml
  - runs: cd ~ && rbw unlock && fnox sync --provider sync-age --local-file --force

The fnox shell block (FNOX_AGE_KEY_FILE, fnox activate, the fs alias) lives in
the tracked ~/.bashrc; this task does not modify shell config.

Tracked vs local files:
  - ~/fnox.toml is tracked by this repo and lists Bitwarden secret references
  - ~/.config/fnox/age.txt is private and must stay local to this machine
  - ~/.config/fnox/config.toml is machine-local fnox provider config
  - ~/fnox.local.toml is the machine-local encrypted sync cache

If rbw is not configured yet, run:
  rbw config set email <your-bitwarden-email>
  rbw login

Options:
  --no-sync   Configure files only; do not unlock rbw or sync secrets
  -h, --help  Show this help
USAGE
}

sync_secrets=true
AGE_RECIPIENT=""

for arg in "$@"; do
  case "$arg" in
    --no-sync) sync_secrets=false ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    echo "Install bootstrap dependencies first: mise bootstrap packages apply && mise install" >&2
    exit 1
  fi
}

ensure_age_key() {
  local key_file="$HOME/.config/fnox/age.txt"
  mkdir -p "$(dirname "$key_file")"

  if [[ ! -f "$key_file" ]]; then
    echo "Generating age key: $key_file"
    age-keygen -o "$key_file"
  else
    echo "Age key already exists: $key_file"
  fi

  chmod 600 "$key_file"

  local recipient=""
  recipient="$(grep -m1 '^# public key:' "$key_file" | sed 's/^# public key: //')"
  if [[ -z "$recipient" ]]; then
    echo "Could not read age public key from $key_file" >&2
    exit 1
  fi

  AGE_RECIPIENT="$recipient"
}

ensure_sync_age_provider() {
  local recipient="$1"
  local config_file="$HOME/.config/fnox/config.toml"
  mkdir -p "$(dirname "$config_file")"
  touch "$config_file"

  if grep -Eq '^\[providers\.sync-age\]' "$config_file"; then
    echo "fnox sync-age provider already exists: $config_file"
    return
  fi

  cat >>"$config_file" <<EOF

# Added by ~/.dotfiles setup-fnox. Machine-local; do not commit.
[providers.sync-age]
type = "age"
recipients = ["$recipient"]
key_file = "~/.config/fnox/age.txt"
EOF

  echo "Added fnox sync-age provider: $config_file"
}

sync_local_cache() {
  if [[ ! -e "$HOME/fnox.toml" ]]; then
    echo "Missing ~/fnox.toml. Run: mise bootstrap dotfiles apply" >&2
    exit 1
  fi

  if grep -Eq '(^|[[:space:]])sync[[:space:]]*=' "$HOME/fnox.toml"; then
    echo "Warning: ~/fnox.toml contains sync fields." >&2
    echo "The shared manifest should normally keep sync fields in ~/fnox.local.toml." >&2
  fi

  echo "Unlocking rbw and syncing local fnox cache..."
  if ! rbw unlock; then
    echo "rbw unlock failed." >&2
    echo "If this is first setup, run:" >&2
    echo "  rbw config set email <your-bitwarden-email>" >&2
    echo "  rbw login" >&2
    echo "Then rerun: mise run setup-fnox" >&2
    exit 1
  fi

  (cd "$HOME" && fnox sync --provider sync-age --local-file --force)
  echo "fnox config files:"
  (cd "$HOME" && fnox config-files)
}

require_command age-keygen
require_command rbw
require_command fnox

ensure_age_key
ensure_sync_age_provider "$AGE_RECIPIENT"

if [[ "$sync_secrets" == true ]]; then
  sync_local_cache
else
  echo "Skipped secret sync. Run later: fs"
fi

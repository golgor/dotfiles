#!/usr/bin/env bash

# Restore Notion database and template routes on this machine from Bitwarden,
# so fresh machines or new workspaces don't need manual path configuration.

set -euo pipefail

BW_ITEM="Notion"
DEST_DIR="$HOME/.config/notion-axi"
DEST_FILE="$DEST_DIR/routes.toml"

usage() {
  cat <<'USAGE'
Usage: mise run setup-notion-routes

Restore Notion database and template routes on this machine from Bitwarden.

What this does:
  - verifies rbw is installed
  - unlocks Bitwarden (rbw unlock)
  - fetches routes from Bitwarden item "Notion" (field "notes")
  - validates TOML syntax, required tables ([projects], [tasks]), and route keys in a temporary file
  - atomically installs ~/.config/notion-axi/routes.toml (chmod 600) only after validation succeeds

Options:
  -h, --help  Show this help
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

command -v rbw >/dev/null || { echo "error: rbw not installed — run: mise bootstrap packages apply" >&2; exit 1; }

echo "Unlocking Bitwarden (rbw)..."
rbw unlock

echo "Fetching routes from Bitwarden item '$BW_ITEM' (field 'notes')..."
mkdir -p "$DEST_DIR"
content="$(rbw get "$BW_ITEM" --field notes)"

if [[ -z "${content//[[:space:]]/}" ]]; then
  echo "error: notes field in Bitwarden item '$BW_ITEM' is empty" >&2
  echo "Add the routes.toml configuration into the Notes field of '$BW_ITEM' in Bitwarden, then rerun." >&2
  exit 1
fi

TMP_FILE="$(mktemp "${DEST_DIR}/routes.toml.tmp.XXXXXX")"
trap 'rm -f "$TMP_FILE"' EXIT

chmod 600 "$TMP_FILE"
printf '%s\n' "$content" > "$TMP_FILE"

python3 - <<'PY' "$TMP_FILE"
import sys, tomllib

try:
    with open(sys.argv[1], "rb") as f:
        data = tomllib.load(f)
except Exception as e:
    sys.exit(f"error: restored routes configuration is not valid TOML: {e}")

required_tables = ["projects", "tasks"]
required_keys = ["database_id", "data_source_id", "template_id"]

for table in required_tables:
    if table not in data or not isinstance(data[table], dict):
        sys.exit(f"error: routes configuration is missing [{table}] section")
    for key in required_keys:
        val = data[table].get(key)
        if not val or not isinstance(val, str) or not val.strip():
            sys.exit(f"error: [{table}] is missing or has empty required key '{key}'")
PY

mv -f "$TMP_FILE" "$DEST_FILE"
trap - EXIT

echo "Done. Notion routes verified and restored to $DEST_FILE."

#!/usr/bin/env bash
# Make dotfiles-managed CLI tools globally resolvable by mise shims.
#
# The versions live in this repo's [tools] for bootstrap/install, but these are
# user-level commands expected to work from arbitrary directories. Without a
# global version, running a shim from ~ fails with "No version is set".

set -euo pipefail

tools=(
  "atuin@18.19.0"
  "kubectl@1.36.2"
  "kubectx@0.11.0"
  "kubens@0.11.0"
  "fnox@latest"
)

for tool in "${tools[@]}"; do
  echo "Setting global mise tool: $tool"
  mise use -g "$tool"
done

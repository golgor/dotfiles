#!/usr/bin/env bash
# Install Google Cloud CLI packages on Arch/Omarchy.
#
# mise's built-in bootstrap package managers do not handle AUR on this machine
# without an extra package plugin, so this task uses the available AUR helper
# directly. It is idempotent: installed packages are skipped.

set -euo pipefail

packages=(
  google-cloud-cli
  google-cloud-cli-component-gke-gcloud-auth-plugin
)

if [[ ! -f /etc/arch-release ]]; then
  echo "Skipping Google Cloud CLI package install: this task supports Arch/Omarchy only."
  exit 0
fi

missing=()
for package in "${packages[@]}"; do
  if ! pacman -Q "$package" >/dev/null 2>&1; then
    missing+=("$package")
  fi
done

if (( ${#missing[@]} == 0 )); then
  echo "Google Cloud CLI packages are already installed."
  exit 0
fi

helper=""
if command -v yay >/dev/null 2>&1; then
  helper="yay"
elif command -v paru >/dev/null 2>&1; then
  helper="paru"
else
  echo "Missing AUR helper: install yay or paru first." >&2
  exit 1
fi

echo "Installing Google Cloud CLI packages with $helper: ${missing[*]}"
"$helper" -S --needed --noconfirm "${missing[@]}"

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "plan",
          "default"
        ]
      },
      "type": "registry"
    }
  },
  "prettier": {
    "allowed": true
  },
  "use_system_window_tabs": false,
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "debugger": {
    "button": true
  },
  "terminal": {
    "copy_on_select": true
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "mcp:mcp-server-sequential-thinking:sequentialthinking": {
          "default": "allow"
        }
      }
    },
    "dock": "left",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4.6-fast"
    },
    "model_parameters": []
  },
  "minimap": {
    "show": "auto"
  },
  "languages": {
    "Python": {
      "preferred_line_length": 120,
      "language_servers": [
        // Disable basedpyright and enable ty, and otherwise
        // use the default configuration.
        "ty",
        "!basedpyright"
      ]
    }
  },
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}
